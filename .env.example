# Rename this file to .env and fill in real values before running docker compose

POSTGRES_DB=sonar
POSTGRES_USER=sonar
POSTGRES_PASSWORD=change_me_to_a_strong_password

# JVM heap sizes - keep these modest on a small EC2 instance.
# Together, web + ce + search heaps should stay comfortably under the
# sonarqube mem_limit set in docker-compose.yml (2G by default below).
SONAR_WEB_JVM_OPTS=-Xmx512m -Xms256m
SONAR_CE_JVM_OPTS=-Xmx512m -Xms256m
SONAR_SEARCH_JVM_OPTS=-Xmx512m -Xms256m
